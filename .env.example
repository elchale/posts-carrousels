# La única variable que la app usa, y es opcional.
#
# Con ella, el avance (descargado / publicado) se guarda en Postgres y te sigue
# entre celular y laptop. Sin ella, la app funciona igual pero guarda solo en el
# navegador — y Safari borra el almacenamiento de un sitio a los 7 días sin
# abrirlo, así que en ese caso conviene usar /respaldo.
#
# Para correr localmente contra la base: copia este archivo a .env.local y pon
# el string de conexión. Los .env están en .gitignore.

DATABASE_URL=postgresql://usuario:clave@host/basededatos?sslmode=require
