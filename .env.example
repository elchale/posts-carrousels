# Copia este archivo a .env.local para correr contra la base desde la laptop.
# Los .env estan en .gitignore: el de produccion, con las credenciales de
# verdad, es .env.prod y no se sube a ningun lado.


# --- El avance compartido entre celular y laptop (opcional) -----------------
# Sin esta variable la app funciona igual, pero el avance se queda en el
# navegador y Safari lo borra a los 7 dias sin abrir el sitio.

DATABASE_URL=postgresql://usuario:clave@host/basededatos?sslmode=require


# --- De donde salen los ORIGINALES (opcional) -------------------------------
# Vacio = del mismo deploy (public/posts). Con un bucket, el manifest sale con
# URLs absolutas y el deploy se queda en codigo: baja de ~5 min a ~40 s. Van las
# TRES carpetas (originales, previews y miniaturas). La lee scripts/build-index.mjs
# al generar data/index.json, asi que hay que volver a correr
# `npm run prepare-assets` despues de cambiarla.
#
# Antes de activarla, el bucket necesita CORS o "Guardar N fotos" deja de
# funcionar en todos los posts (pasa a ser un fetch de otro origen):
#    node scripts/upload-media.mjs --cors
#
# MEDIA_BASE=https://storage.googleapis.com/qolca-basic-santiago/carruseles


# --- Para subir al bucket desde la laptop (no van a Vercel) -----------------
# Las usa `npm run upload-media`. La llave vive aparte, en .gcs/key.json:
#    node scripts/extract-gcs-key.mjs <ruta a un .env.prod que ya la tenga>
#
# GCS_BUCKET_NAME=qolca-basic-santiago
# GCS_PROJECT_ID=avian-volt-457704-c9
# GCS_PREFIX=carruseles
