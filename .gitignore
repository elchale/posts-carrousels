# --- los renders: fuera del repo desde el 26-08-2026 ---------------------------
# brands/<marca>/out/ son 694 MB de JPEG y cada re-render dejaba los viejos en
# .git para siempre (llego a 4,9 GB, y GitHub se pone dificil pasando los 5).
# Ahora viven en el bucket y en la laptop. En su lugar SE COMMITEA el manifest,
# data/index.json, que es lo unico que el build necesita: 1,5 MB en vez de
# 694 MB, y build-index lo detecta solo (no hay out/ -> sirve el manifest).
/brands/*/out/

# --- web app build artifacts (all regenerated by scripts/build-index.mjs + next build) ---
# NOTE: every path here is rooted with a leading slash on purpose. A bare "out/"
# would also match brands/<marca>/out/ and untrack all 2450 published images.
/node_modules/
/.next/
/out/
/public/posts/
/public/preview/
/public/thumb/
/public/icon.svg
/public/icon-180.png
/public/icon-512.png
/.vercel/

# --- debug output from tools/shots.py --sheet ---
/tools/_shots-sheet.png
__pycache__/
*.pyc

# --- credenciales: NUNCA al repo -------------------------------------------
# .env.prod trae el string de conexión de Neon. El repo es público-adyacente
# (GitHub), así que cualquier .env queda fuera, sin excepciones.
.env
.env.*
!.env.example

# --- os / editor noise ---
.DS_Store
Thumbs.db
*.log
/tools/_frio.json

# --- perfil de Chrome del scanner de TikTok (cookies): NUNCA al repo ---
/tools/.ttprofile/
/data/.hashes.json

# --- llave de servicio de GCS (bucket compartido): NUNCA al repo ---
/.gcs/
